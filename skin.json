{
	"name": "Chroma",
	"namemsg": "skinname-chroma",
	"version": "0.1.0",
	"author": [
		"HAHAHAHAHAYINING"
	],
	"url": "https://github.com/chroma-mediawiki/mediawiki-skins-Chroma",
	"descriptionmsg": "chroma-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.43.0 < 1.44.0"
	},
	"ValidSkinNames": {
		"chroma": {
			"class": "MediaWiki\\Skins\\Chroma\\SkinChroma",
			"args": [
				{
					"name": "chroma",
					"responsive": true,
					"template": "skin",
					"styles": [
						"skins.chroma.core",
						"skins.chroma.styles"
					],
					"scripts": [
						"skins.chroma.scripts"
					],
					"menus": [
						"namespaces",
						"views",
						"actions",
						"variants",
						"personal"
					],
					"messages": [
						"sitename",
						"chroma-skip-to-content",
						"chroma-menu",
						"chroma-theme",
						"chroma-reading-mode",
						"toc",
						"chroma-search",
						"chroma-layout",
						"chroma-nav",
						"chroma-tools",
						"chroma-edit"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"Chroma": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.chroma.styles": {
			"styles": {
				"resources/styles/tokens.css": {
					"media": "screen"
				},
				"resources/styles/tokens-presets.css": {
					"media": "screen"
				},
				"resources/styles/base.css": {
					"media": "screen"
				},
				"resources/styles/codex-bridge.css": {
					"media": "screen"
				},
				"resources/styles/print.css": {
					"media": "print"
				},
				"resources/styles/extensions.css": {
					"media": "screen"
				}
			}
		},
		"skins.chroma.scripts": {
			"scripts": [
				"resources/scripts/chroma.js"
			]
		},
		"skins.chroma.core": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"accessibility": true,
				"normalize": true,
				"elements": true,
				"content-media": true,
				"content-links": true,
				"content-tables": true,
				"content-links-external": true,
				"logo": true,
				"i18n-ordered-lists": true,
				"i18n-all-lists-margins": true,
				"i18n-headings": true
			}
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Chroma"
	},
	"manifest_version": 2,
	"AutoloadNamespaces": {
		"MediaWiki\\Skins\\Chroma\\": "includes/"
	},
	"Hooks": {
		"GetPreferences": "MediaWiki\\Skins\\Chroma\\Hooks::onGetPreferences",
		"OutputPageBodyAttributes": "MediaWiki\\Skins\\Chroma\\Hooks::onOutputPageBodyAttributes"
	},
	"ResourceModuleSkinStyles": {
		"+mediawiki.special.preferences.styles.ooui": {
			"chroma": "resources/styles/skinStyles/preferences.css"
		},
		"+oojs-ui-core.styles": {
			"chroma": "resources/styles/skinStyles/oojs-ui.css"
		},
		"+oojs-ui-widgets.styles": {
			"chroma": "resources/styles/skinStyles/oojs-ui.css"
		}
	}
}
