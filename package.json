{
  "name": "chroma-mediawiki-skin",
  "private": true,
  "version": "0.6.0",
  "description": "Build tooling for the Chroma MediaWiki skin",
  "keywords": [
    "mediawiki",
    "mediawiki-skin",
    "skin",
    "material-design",
    "material-design-3",
    "m3-expressive",
    "design-tokens",
    "php",
    "css",
    "dark-mode",
    "accessibility",
    "theme"
  ],
  "type": "module",
  "scripts": {
    "tokens": "node tools/generate-tokens.mjs '#006A6A' resources/styles/tokens.css tokens.json",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint resources/scripts",
    "lint:css": "stylelint resources/styles/*.css",
    "test": "echo 'No automated tests configured.'",
    "presets": "node tools/generate-presets.mjs"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.2.7",
    "eslint": "^9.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
