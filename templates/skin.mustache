<a class="chroma-skip-link" href="#content">{{msg-chroma-skip-to-content}}</a>
{{{html-site-notice}}}
<div id="chroma-shell" class="chroma-shell">
	<header id="chroma-app-bar" class="chroma-app-bar">
		<div class="chroma-app-bar__start">
			<button type="button" class="chroma-icon-button" id="chroma-drawer-toggle" aria-label="{{msg-chroma-menu}}" aria-expanded="false" aria-controls="chroma-drawer">
				<span class="chroma-icon" data-icon="menu" aria-hidden="true"></span>
			</button>
			<a class="chroma-brand" href="{{link-mainpage}}">
				{{#has-logo}}
				<span class="chroma-brand__mark" aria-hidden="true">
					{{#data-logos}}{{#icon}}<img src="{{.}}" alt="">{{/icon}}{{^icon}}{{#1x}}<img src="{{.}}" alt="">{{/1x}}{{/icon}}{{/data-logos}}
				</span>
				{{/has-logo}}
				<span class="chroma-brand__text">{{sitename}}</span>
			</a>
		</div>
		<a class="chroma-icon-button chroma-search-toggle" href="{{link-search}}" aria-label="{{msg-chroma-search}}">
			<span class="chroma-icon" data-icon="search" aria-hidden="true"></span>
		</a>
		{{#data-search-box}}
		<form class="chroma-search" action="{{form-action}}" method="get" role="search">
			<input type="hidden" name="title" value="{{page-title}}">
			<span class="chroma-icon" data-icon="search" aria-hidden="true"></span>
			{{{html-input}}}
			{{{html-button-search}}}
		</form>
		{{/data-search-box}}
		<div class="chroma-app-bar__actions">
			<details class="chroma-app-menu">
				<summary class="chroma-icon-button" aria-label="{{msg-chroma-view-options}}">
					<span class="chroma-icon" data-icon="tune" aria-hidden="true"></span>
				</summary>
				<div class="chroma-app-menu__panel">
					<button type="button" class="chroma-menu-item" id="chroma-layout-toggle"><span class="chroma-icon" data-icon="layout" aria-hidden="true"></span><span>{{msg-chroma-layout}}</span></button>
					<button type="button" class="chroma-menu-item" id="chroma-theme-toggle"><span class="chroma-icon" data-icon="contrast" aria-hidden="true"></span><span>{{msg-chroma-theme}}</span></button>
					<button type="button" class="chroma-menu-item" id="chroma-reading-toggle"><span class="chroma-icon" data-icon="book" aria-hidden="true"></span><span>{{msg-chroma-reading-mode}}</span></button>
				</div>
			</details>
			<details class="chroma-app-menu chroma-account-menu">
				<summary class="chroma-icon-button" aria-label="{{msg-chroma-account}}">
					<span class="chroma-icon" data-icon="person" aria-hidden="true"></span>
				</summary>
				<div class="chroma-app-menu__panel">
					{{#data-portlets}}{{#data-personal}}<ul class="chroma-user-menu">{{{html-items}}}</ul>{{/data-personal}}{{/data-portlets}}
				</div>
			</details>
		</div>
	</header>
	<div class="chroma-body">
		<aside id="chroma-drawer" class="chroma-drawer chroma-nav" aria-label="{{msg-chroma-menu}}">
			{{#data-portlets-sidebar}}
			{{#data-portlets-first}}
			<nav aria-label="{{msg-chroma-nav}}">
				<p class="chroma-nav__label">{{msg-chroma-nav}}</p>
				<ul>{{{html-items}}}</ul>
			</nav>
			{{/data-portlets-first}}
			{{#array-portlets-rest}}
			<nav aria-label="{{msg-chroma-tools}}">
				<p class="chroma-nav__label">{{msg-chroma-tools}}</p>
				<ul>{{{html-items}}}</ul>
			</nav>
			{{/array-portlets-rest}}
			{{/data-portlets-sidebar}}
		</aside>
		<main id="content" class="chroma-content">
			<div class="chroma-page">
				<div class="chroma-page__topline">
					{{#data-portlets}}
					{{#data-namespaces}}<nav class="chroma-tabs" aria-label="Namespaces"><ul>{{{html-items}}}</ul></nav>{{/data-namespaces}}
					{{#data-views}}<nav class="chroma-tabs chroma-tabs--views" aria-label="Views"><ul>{{{html-items}}}</ul></nav>{{/data-views}}
					{{/data-portlets}}
				</div>
				<header class="chroma-page__header">
					{{{html-title-heading}}}
					{{{html-subtitle}}}
				</header>
				<div class="chroma-page__body">
					<div class="chroma-article">
						<div class="chroma-prose">
							{{{html-body-content}}}
						</div>
						{{{html-categories}}}
					</div>
					{{#data-toc}}
					<aside class="chroma-toc" aria-label="{{msg-toc}}" id="chroma-toc">
						<p class="chroma-toc__title">{{msg-toc}}</p>
						<ul>
							{{#array-sections}}
							<li>
								<a href="#{{anchor}}">{{{line}}}</a>
								{{#array-sections}}
								<ul>
									<li>
										<a href="#{{anchor}}">{{{line}}}</a>
										{{#array-sections}}
										<ul>
											<li><a href="#{{anchor}}">{{{line}}}</a></li>
										</ul>
										{{/array-sections}}
									</li>
								</ul>
								{{/array-sections}}
							</li>
							{{/array-sections}}
						</ul>
					</aside>
					{{/data-toc}}
				</div>
			</div>
		</main>
	</div>
	<footer id="chroma-footer" class="chroma-footer">
		<div class="chroma-footer__inner">
			{{#data-footer}}
			{{#data-info}}<ul>{{{html-items}}}</ul>{{/data-info}}
			{{#data-places}}<ul>{{{html-items}}}</ul>{{/data-places}}
			{{/data-footer}}
		</div>
	</footer>
</div>
{{{html-after-content}}}
