<a class="chroma-skip-link" href="#content">{{msg-chroma-skip-to-content}}</a>
{{{html-site-notice}}}
<div id="chroma-shell" class="chroma-shell" data-chroma-layout="app">
	<header id="chroma-app-bar" class="chroma-app-bar">
		<div class="chroma-app-bar__start">
			<button type="button" class="chroma-icon-button" id="chroma-drawer-toggle" aria-label="{{msg-chroma-menu}}" aria-expanded="false" aria-controls="chroma-drawer">
				<span class="chroma-icon" data-icon="menu" aria-hidden="true"></span>
			</button>
			<a class="chroma-brand" href="{{link-mainpage}}">
				<span class="chroma-brand__mark" aria-hidden="true">C</span>
				<span class="chroma-brand__text">{{sitename}}</span>
			</a>
		</div>
		{{#data-search-box}}
		<form class="chroma-search" action="{{form-action}}" method="get" role="search">
			<input type="hidden" name="title" value="{{page-title}}">
			<span class="chroma-icon" data-icon="search" aria-hidden="true"></span>
			{{{html-input}}}
			{{{html-button-search}}}
		</form>
		{{/data-search-box}}
		<div class="chroma-app-bar__actions">
			<button type="button" class="chroma-icon-button" id="chroma-layout-toggle" aria-label="Layout">
				<span class="chroma-icon" data-icon="layout" aria-hidden="true"></span>
			</button>
			<button type="button" class="chroma-icon-button" id="chroma-theme-toggle" aria-label="{{msg-chroma-theme}}">
				<span class="chroma-icon" data-icon="contrast" aria-hidden="true"></span>
			</button>
			<button type="button" class="chroma-icon-button" id="chroma-reading-toggle" aria-label="{{msg-chroma-reading-mode}}">
				<span class="chroma-icon" data-icon="book" aria-hidden="true"></span>
			</button>
			{{#data-portlets}}
			{{#data-user-menu}}<ul class="chroma-user-menu">{{{html-items}}}</ul>{{/data-user-menu}}
			{{/data-portlets}}
		</div>
	</header>
	<div class="chroma-body">
		<aside id="chroma-drawer" class="chroma-drawer chroma-nav" aria-label="{{msg-chroma-menu}}">
			{{#data-portlets-sidebar}}
			{{#data-portlets-first}}<ul>{{{html-items}}}</ul>{{/data-portlets-first}}
			{{#array-portlets-rest}}<ul>{{{html-items}}}</ul>{{/array-portlets-rest}}
			{{/data-portlets-sidebar}}
		</aside>
		<main id="content" class="chroma-content">
			<div class="chroma-page-actions">
				{{#data-portlets}}
				{{#data-associated-pages}}<ul class="chroma-tabs">{{{html-items}}}</ul>{{/data-associated-pages}}
				{{#data-views}}<ul class="chroma-tabs">{{{html-items}}}</ul>{{/data-views}}
				{{/data-portlets}}
			</div>
			<div class="chroma-article">
				{{{html-subtitle}}}
				<div class="chroma-prose">
					{{{html-body-content}}}
				</div>
				{{{html-categories}}}
			</div>
		</main>
		{{#data-toc}}
		<aside class="chroma-toc" aria-label="Contents">
			<p class="chroma-toc__title">{{msg-toc}}</p>
			<ul>
				{{#array-sections}}
				<li><a href="#{{anchor}}">{{line}}</a></li>
				{{/array-sections}}
			</ul>
		</aside>
		{{/data-toc}}
	</div>
	<footer id="chroma-footer" class="chroma-footer">
		{{#data-footer}}
		{{#data-info}}<ul>{{{html-items}}}</ul>{{/data-info}}
		{{#data-places}}<ul>{{{html-items}}}</ul>{{/data-places}}
		{{/data-footer}}
	</footer>
</div>
{{{html-after-content}}}
